# Spike S0 - copy to .env (gitignored) and fill in. Never commit .env.
# Facilitator metering key from https://x402.celo.org (shown once). Seller side only.
X402_API_KEY=
# Only "testnet" (Celo Sepolia) is accepted by this spike.
X402_NETWORK=testnet
# Seller's own receiving address (0x...). Receives the testnet USDC.
SELLER_PAY_TO=
# Throwaway testnet buyer key. Create it with `npm run wallet:new`; do not paste it by hand.
BUYER_PRIVATE_KEY=
# Seller HTTP port.
PORT=3000
